<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="co.yixiang.yshop.module.member.dal.mysql.user.VipLevelConfigMapper">

    <!-- 查询全部会员等级配置，按等级升序 -->
    <select id="selectAllLevel" resultType="co.yixiang.yshop.module.member.dal.dataobject.user.VipLevelConfigDO">
        SELECT id, level, level_name, need_growth, color, create_time
        FROM vip_level_config
        ORDER BY level ASC
    </select>

</mapper>