<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="co.yixiang.yshop.module.member.dal.mysql.user.PointGoodsMapper">
    <select id="selectOnlineGoods" resultType="co.yixiang.yshop.module.member.dal.dataobject.user.StorePointGoodsDO">
        SELECT id,name,image,need_point,stock FROM store_point_goods
        WHERE status=1 AND stock>0
    </select>
    <select id="selectById" resultType="co.yixiang.yshop.module.member.dal.dataobject.user.StorePointGoodsDO">
        SELECT * FROM store_point_goods WHERE id=#{id}
    </select>
</mapper>