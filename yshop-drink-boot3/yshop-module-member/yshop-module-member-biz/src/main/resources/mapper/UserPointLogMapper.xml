<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="co.yixiang.yshop.module.member.dal.mysql.user.UserPointLogMapper">
    <select id="selectLog" resultType="co.yixiang.yshop.module.member.dal.dataobject.user.UserPointLogDO">
        SELECT type,point,remark,created_at FROM user_point_log
        WHERE user_id=#{userId} ORDER BY id DESC
    </select>
    <insert id="insert">
        INSERT INTO user_point_log(user_id,type,point,remark)
        VALUES(#{userId},#{type},#{point},#{remark})
    </insert>
</mapper>