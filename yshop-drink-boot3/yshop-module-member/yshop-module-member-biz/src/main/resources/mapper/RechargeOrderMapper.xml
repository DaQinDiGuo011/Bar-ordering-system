<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="co.yixiang.yshop.module.member.dal.mysql.user.RechargeOrderMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into recharge_order(order_no,user_id,package_id,recharge_amount,gift_amount,gift_grow_value,pay_status)
        values(#{orderNo},#{userId},#{packageId},#{rechargeAmount},#{giftAmount},#{giftGrowValue},#{payStatus})
    </insert>
    <select id="selectByOrderNo" resultType="co.yixiang.yshop.module.member.dal.dataobject.user.RechargeOrderDO">
        select * from recharge_order where order_no = #{orderNo}
    </select>
    <update id="updatePaySuccess">
        update recharge_order
        set pay_status = 1, pay_time = #{now}
        where order_no = #{orderNo} and pay_status = 0
    </update>
</mapper>