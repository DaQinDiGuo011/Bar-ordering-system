<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="co.yixiang.yshop.module.member.dal.mysql.user.PointExchangeMapper">
    <select id="selectUserExchange" resultType="co.yixiang.yshop.module.member.dal.dataobject.user.StorePointExchangeDO">
        SELECT order_no,goods_name,use_point,status,created_at
        FROM store_point_exchange
        WHERE user_id=#{userId}
        <if test="status != null">
            AND status=#{status}
        </if>
        ORDER BY id DESC
    </select>
    <insert id="insert">
        INSERT INTO store_point_exchange(order_no,user_id,goods_id,goods_name,use_point,status)
        VALUES(#{orderNo},#{userId},#{goodsId},#{goodsName},#{usePoint},#{status})
    </insert>
</mapper>